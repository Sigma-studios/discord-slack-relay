# ── Slack ────────────────────────────────────────────────────────────────
# Bot token (xoxb-…): reads channels, posts relayed messages, receives events.
SLACK_BOT_TOKEN=xoxb-...
# App-level token (xapp-…) with connections:write, for Socket Mode.
SLACK_APP_TOKEN=xapp-...

# ── Discord ──────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=...
DISCORD_GUILD_ID=000000000000000000

# ── Relay behaviour ────────────────────────────────────────────────────────
# SQLite file (on a façade volume, e.g. /data/relay.db).
DATABASE_URL=sqlite:///data/relay.db?mode=rwc
# Slack display name for relayed Discord messages. {name} = Discord display name.
SLACK_NAME_TEMPLATE={name} (Discord)
# Heartbeat file touched each healthy loop; the Docker HEALTHCHECK reads it.
HEARTBEAT_FILE=/data/heartbeat
RUST_LOG=info,discord_slack_relay=debug
