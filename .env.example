# ── Slack ────────────────────────────────────────────────────────────────
# Bot token (xoxb-…): reads channels the bot is a member of, receives events.
SLACK_BOT_TOKEN=xoxb-...
# App-level token (xapp-…) with connections:write, for Socket Mode.
SLACK_APP_TOKEN=xapp-...
# User token (xoxp-…): posts the Discord→Slack messages AS YOU.
SLACK_USER_TOKEN=xoxp-...

# ── Discord ──────────────────────────────────────────────────────────────
# Bot token from the Discord developer portal.
DISCORD_BOT_TOKEN=...
# The guild (server) ID where mirrored channels are created.
DISCORD_GUILD_ID=000000000000000000

# ── Relay behaviour ────────────────────────────────────────────────────────
# SQLite file (on a façade volume, e.g. /data/relay.db).
DATABASE_URL=sqlite:///data/relay.db?mode=rwc
# Text appended to Discord→Slack messages. {name} = Discord display name.
SLACK_CREDIT_TEMPLATE=\n\n_— {name} via Discord_
# Heartbeat file touched each healthy loop; the Docker HEALTHCHECK reads it.
HEARTBEAT_FILE=/data/heartbeat
RUST_LOG=info,discord_slack_relay=debug
